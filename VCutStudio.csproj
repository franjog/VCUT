<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VCUT</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS8981</NoWarn>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\vcut.ico</ApplicationIcon>
    <Version>1.6.0</Version>
    <AssemblyVersion>1.6.0.0</AssemblyVersion>
    <FileVersion>1.6.0.0</FileVersion>
    <Product>VCutStudio</Product>
    <Description>Recorte de vídeo mediante copia directa, sin recodificación.</Description>
    <Optimize>true</Optimize>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <RunTestsOnBuild Condition="'$(RunTestsOnBuild)' == ''">true</RunTestsOnBuild>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="VCUT.Core\**;VCUT.Tests\**" />
    <EmbeddedResource Remove="VCUT.Core\**;VCUT.Tests\**" />
    <EmbeddedResource Include="Assets\vcut-mark.png" LogicalName="VCUT.Assets.vcut-mark.png" />
    <None Remove="VCUT.Core\**;VCUT.Tests\**;.packages\**;tools\**;Assets\vcut-mark.png;Assets\vcut-source.png;Assets\vcut.ico;Assets\libvlc-plugins.dat" />
    <None Include="Assets\vcut-source.png" />
    <Content Include="Assets\libvlc-plugins.dat" Link="libvlc\win-x64\plugins\plugins.dat" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <ProjectReference Include="VCUT.Core\VCUT.Core.csproj" />
    <ProjectReference Include="VCUT.Tests\VCUT.Tests.csproj" ReferenceOutputAssembly="false" Private="false" Condition="'$(RunTestsOnBuild)' == 'true'" />
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
    <Content Include="tools\ffmpeg\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CheckVideoTools" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\tools\ffmpeg\ffmpeg.exe') Or !Exists('$(MSBuildProjectDirectory)\tools\ffmpeg\ffprobe.exe')" Text="Faltan FFmpeg y FFprobe. Ejecuta powershell -ExecutionPolicy Bypass -File scripts\Setup-FFmpeg.ps1" />
  </Target>

</Project>

