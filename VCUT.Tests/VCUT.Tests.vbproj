<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VCUT.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RunTestsOnBuild Condition="'$(RunTestsOnBuild)' == ''">true</RunTestsOnBuild>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.2" />
    <ProjectReference Include="..\VCUT.Core\VCUT.Core.vbproj" />
    <Content Include="..\tools\ffmpeg\ffmpeg.exe;..\tools\ffmpeg\ffprobe.exe" Link="tools\ffmpeg\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- VSTest runs the already built assembly; it never invokes another build. -->
  <Target Name="RunTestsAfterBuild" AfterTargets="Build" Condition="'$(RunTestsOnBuild)' == 'true' And '$(DesignTimeBuild)' != 'true' And '$(IsCrossTargetingBuild)' != 'true'">
    <Exec Command="dotnet vstest &quot;$(TargetPath)&quot; --logger:&quot;console;verbosity=minimal&quot;" StdOutEncoding="utf-8" StdErrEncoding="utf-8" IgnoreStandardErrorWarningFormat="true" />
  </Target>
</Project>
